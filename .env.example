# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_TOKEN=dev_admin_token
SECRET_KEY=change_me_in_production_32_chars_min

# ─── Database ─────────────────────────────────────────────────────────────────
# Production: use Supabase, Railway, or Render managed Postgres
DATABASE_URL=postgresql+psycopg2://dmf:dmfpass@localhost:5432/dmf

# ─── Redis ────────────────────────────────────────────────────────────────────
# Production: use Upstash Redis (https://upstash.com) or Railway Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── AI Providers ─────────────────────────────────────────────────────────────
AI_PROVIDER=anthropic   # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── DSP Credentials ──────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_PRIVATE_KEY=

# ─── Platform ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development   # development | staging | production

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8001  # Production: your Railway/Render API URL

# ─── Cloud Deployment ─────────────────────────────────────────────────────────
# Vercel (frontend) — set in GitHub Secrets
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# Railway (backend) — set in GitHub Secrets
# RAILWAY_TOKEN=
