# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_TOKEN=dev_admin_token
SECRET_KEY=change_me_in_production_32_chars_min

# ─── Database ─────────────────────────────────────────────────────────────────
DB_USER=dmf
DB_PASSWORD=dmfpass
DB_NAME=dmf
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql+psycopg2://dmf:dmfpass@postgres:5432/dmf

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── AI Providers ─────────────────────────────────────────────────────────────
AI_PROVIDER=anthropic   # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── DSP Credentials (add per DSP) ────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_PRIVATE_KEY=

# ─── Platform ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development   # development | staging | production

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=/api
