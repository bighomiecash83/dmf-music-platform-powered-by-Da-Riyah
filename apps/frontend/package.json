{
  "name": "dmf-frontend",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --port 3000",
    "start": "vite --port 3000",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx --report-unused-disable-directives",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "electron": "cross-env NODE_ENV=development electron electron/main.js",
    "electron:build": "npm run build && electron-builder --dir",
    "electron:pack": "npm run build && electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@supabase/supabase-js": "^2.100.0",
    "@tanstack/react-query": "^5.51.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "axios": "^1.7.2",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.407.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0",
    "recharts": "^2.12.7",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.8",
    "jsdom": "^24.1.1",
    "vitest": "^2.0.3"
  },
  "build": {
    "appId": "com.dmfrecords.platform",
    "productName": "DMF Records Platform",
    "copyright": "© 2026 DMF Records Fly Hoolie ENT Co.",
    "directories": { "output": "dist-electron" },
    "files": ["dist/**/*", "electron/**/*", "public/**/*"],
    "icon": "public/logo.png",
    "mac": {
      "category": "public.app-category.music",
      "darkModeSupport": true,
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }]
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "publisherName": "DMF Records Fly Hoolie ENT Co."
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Music"
    }
  }
}
